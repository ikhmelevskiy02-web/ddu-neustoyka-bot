# Токен бота от @BotFather
BOT_TOKEN=

# Ключ Groq API (console.groq.com). Если не задан — бот работает только
# в пошаговом режиме, без распознавания свободного текста и без LLM-объяснений.
GROQ_API_KEY=

# Модель Groq. openai/gpt-oss-120b — актуальная (2026) рекомендованная модель;
# llama-3.3-70b-versatile снята с поддержки в июне 2026, не используйте её.
GROQ_MODEL=openai/gpt-oss-120b

# Включить извлечение параметров из свободного текста через Groq (true/false)
USE_LLM_EXTRACTION=true

# Включить дружелюбный пересказ результата через Groq (true/false)
USE_LLM_EXPLANATION=true

LOG_LEVEL=INFO
